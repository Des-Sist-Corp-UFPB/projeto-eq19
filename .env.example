# Banco de dados

DB_HOST=postgres
DB_PORT=5432
DB_NAME=eq19
DB_USER=eq19
DB_PASSWORD=<SENHA_DO_BANCO>

# URLs da aplicação

FRONTEND_URL=https://eq19.dsc.rodrigor.com
BACKEND_URL=
BACKEND_PORT=8119
VITE_API_BASE_URL=/api

# Assistente de eventos com IA

LITELLM_API_KEY=<CHAVE_LITELLM_DA_EQUIPE>
LITELLM_BASE_URL=https://llm.rodrigor.com
LITELLM_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=15
APP_TIME_ZONE=America/Sao_Paulo
AI_MAX_COMPLETION_TOKENS=300
AI_RETRY_ENABLED=false
AI_MAX_CANDIDATE_GAMES=15
AI_MAX_REQUESTS_PER_USER_HOUR=3
AI_MAX_REQUESTS_PER_DAY=10

# Configuração de e-mail via SMTP

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<EMAIL_SMTP>
SMTP_PASSWORD=<SENHA_DE_APLICATIVO>
SMTP_FROM=<EMAIL_REMETENTE>
SMTP_FROM_NAME=Tabula

# Observabilidade com OpenTelemetry

JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

OTEL_SERVICE_NAME=dsc-eq19
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.dsc.rodrigor.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <TOKEN_FORNECIDO_PELO_PROFESSOR>

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

OTEL_INSTRUMENTATION_LOGBACK_APPENDER_ENABLED=true
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_KEY_VALUE_PAIR_ATTRIBUTES=true